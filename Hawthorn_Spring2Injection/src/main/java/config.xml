<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN 2.0//EN" "http://www.springframework.org/dtd/spring-beans-2.0.dtd">

<beans>
	<!--Setter Injection -->
	<!-- bean is used to create object ,class = kis chiz ka obj create karna hei, name= id-->
	<bean class="com.ts.Hawthorn_Spring2Injection.Teacher" name="tch">
		<!-- setting value of id using bean-->
		<property name="id" value="1"></property>
		<!-- setting value of name using bean-->
		<property name="name" value="Ram"></property>
	</bean>
	
	<!-- Constructor Ingection-->
	<bean class="com.ts.Hawthorn_Spring2Injection.Teacher" name="tch2">
	<constructor-arg value="2"></constructor-arg>
	<constructor-arg value="sham"></constructor-arg>
	</bean>

</beans>
<!--  giving property in bean using getter setter in pojo is called Setter
Injection-->